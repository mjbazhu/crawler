# 只作部署模板；本文件不应直接启动。所有空值均须由受保护配置/进程环境显式提供。
# 不作变量展开：secret:// 等引用须由部署宿主解析，不能原样传给 crawler。
CRAWLER_PERSISTENCE_BACKEND=mysql
CRAWLER_MYSQL_HOST=
CRAWLER_MYSQL_PORT=
CRAWLER_MYSQL_USER=
CRAWLER_MYSQL_PASSWORD=
CRAWLER_MYSQL_DATABASE=
# 正式库必须先在维护窗口显式迁移；常驻进程不自动初始化。
CRAWLER_MYSQL_INIT_SCHEMA=false
CRAWLER_MYSQL_MIGRATIONS_PATH=
CRAWLER_HOST=127.0.0.1
CRAWLER_PORT=19129
CRAWLER_STORAGE_PATH=
CRAWLER_RESOURCE_STORAGE_BACKEND=filesystem
CRAWLER_RESOURCE_PIPELINE_MODE=parallel
# 历史本地不做验收、保留原路径；新任务是否启用 local 由发布计划明确选择。
CRAWLER_RESOURCE_LOCAL_ENABLED=true
CRAWLER_RESOURCE_CLOUD_PROVIDERS=baidu,gdrive
CRAWLER_RESOURCE_BAIDU_ADAPTER=rclone
CRAWLER_RESOURCE_GDRIVE_ADAPTER=rclone
# 必须与已持久固定的视图一致，选择后不能靠重启改平台。
CRAWLER_RESOURCE_LEGACY_VIEW_PROVIDER=
CRAWLER_RESOURCE_CLOUD_VERIFICATION_POLICY=strict_sha256
CRAWLER_RESOURCE_SOURCE_CONCURRENCY=6
CRAWLER_RESOURCE_TRANSFER_CONCURRENCY=9
CRAWLER_RESOURCE_SHUTDOWN_GRACE_MS=30000
CRAWLER_RESOURCE_LOCAL_CONCURRENCY=3
CRAWLER_RESOURCE_LOCAL_TIMEOUT_MS=120000
CRAWLER_RESOURCE_LOCAL_RETRIES=1
CRAWLER_RESOURCE_LOCAL_MAX_BYTES=536870912
CRAWLER_RESOURCE_LOCAL_MAX_BYTES_PER_SECOND=0
CRAWLER_RESOURCE_LOCAL_STAGING_PATH=
CRAWLER_RESOURCE_LOCAL_STAGING_MAX_BYTES=8589934592
CRAWLER_RESOURCE_BAIDU_CONCURRENCY=3
CRAWLER_RESOURCE_BAIDU_TIMEOUT_MS=120000
CRAWLER_RESOURCE_BAIDU_RETRIES=1
CRAWLER_RESOURCE_BAIDU_MAX_BYTES=536870912
CRAWLER_RESOURCE_BAIDU_MAX_BYTES_PER_SECOND=0
CRAWLER_RESOURCE_BAIDU_STAGING_PATH=
CRAWLER_RESOURCE_BAIDU_STAGING_MAX_BYTES=8589934592
CRAWLER_RESOURCE_GDRIVE_CONCURRENCY=3
CRAWLER_RESOURCE_GDRIVE_TIMEOUT_MS=120000
CRAWLER_RESOURCE_GDRIVE_RETRIES=1
CRAWLER_RESOURCE_GDRIVE_MAX_BYTES=536870912
CRAWLER_RESOURCE_GDRIVE_MAX_BYTES_PER_SECOND=0
CRAWLER_RESOURCE_GDRIVE_STAGING_PATH=
CRAWLER_RESOURCE_GDRIVE_STAGING_MAX_BYTES=8589934592
# 各端可独立复用已有已登录 remote；URL 仅为本机 RC 示例，不是网盘 URL。
CRAWLER_RESOURCE_BAIDU_RCLONE_RC_URL=http://127.0.0.1:5572
CRAWLER_RESOURCE_BAIDU_RCLONE_RC_USER=
CRAWLER_RESOURCE_BAIDU_RCLONE_RC_PASSWORD=
CRAWLER_RESOURCE_BAIDU_RCLONE_TARGET_FS=
CRAWLER_RESOURCE_GDRIVE_RCLONE_RC_URL=http://127.0.0.1:5573
CRAWLER_RESOURCE_GDRIVE_RCLONE_RC_USER=
CRAWLER_RESOURCE_GDRIVE_RCLONE_RC_PASSWORD=
CRAWLER_RESOURCE_GDRIVE_RCLONE_TARGET_FS=
CRAWLER_RCLONE_API_TIMEOUT_MS=10000
CRAWLER_RCLONE_API_MAX_RESPONSE_BYTES=1048576
# producer 需独立审阅密钥供应；关闭不删除历史任务。
CRAWLER_RESOURCE_PRODUCER_ENABLED=false
CRAWLER_RESOURCE_PRODUCER_CONCURRENCY=1
CRAWLER_RESOURCE_PRODUCER_TIMEOUT_MS=120000
CRAWLER_RESOURCE_PRODUCER_RETRIES=2
CRAWLER_OUTBOUND_VERIFY_TLS=true
CRAWLER_LOG_LEVEL=info
CRAWLER_LOG_TEXT_FILE_ENABLED=false
CRAWLER_LOG_JSON_FILE_ENABLED=false
# 以下仅由部署宿主读取，不是 crawler 配置；两份私有副本复用已有登录。
# CRAWLER_DEPLOYMENT_BAIDU_RCLONE_CONFIG=
# CRAWLER_DEPLOYMENT_GDRIVE_RCLONE_CONFIG=
