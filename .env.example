# Crawler MySQL 配置示例，复制为 .env 后填写真实连接信息
CRAWLER_PERSISTENCE_BACKEND=mysql
CRAWLER_MYSQL_HOST=127.0.0.1
CRAWLER_MYSQL_PORT=3306
CRAWLER_MYSQL_USER=root
CRAWLER_MYSQL_PASSWORD=
CRAWLER_MYSQL_DATABASE=crawler
# schema 默认启动初始化使用 migrations
CRAWLER_MYSQL_MIGRATIONS_PATH=sql/mysql/migrations
CRAWLER_MYSQL_INIT_SCHEMA=true
CRAWLER_MYSQL_IO_THREADS=2
CRAWLER_MYSQL_MAX_POOL_SIZE=4
CRAWLER_MYSQL_CONNECT_TIMEOUT_SECONDS=5
CRAWLER_MYSQL_RETRY_INTERVAL_SECONDS=2
CRAWLER_MYSQL_PING_TIMEOUT_SECONDS=5
CRAWLER_MYSQL_STARTUP_TIMEOUT_MS=30000

# 运行日志配置。控制台始终输出文本；文本文件和 JSONL 文件可独立开启，也可同时保存
CRAWLER_LOG_LEVEL=info
CRAWLER_LOG_CONSOLE=true
CRAWLER_LOG_TEXT_FILE_ENABLED=true
CRAWLER_LOG_TEXT_FILE=logs/crawler.log
CRAWLER_LOG_JSON_FILE_ENABLED=false
CRAWLER_LOG_JSON_FILE=logs/crawler.jsonl

# 集成测试参数
CRAWLER_TEST_MIGU_SINGER_ID=112
CRAWLER_TEST_MIGU_LIMIT=20
CRAWLER_TEST_MIGU_ALBUM_LIMIT=20
CRAWLER_TEST_MIGU_SINGER_TAB=huayu-nan
CRAWLER_TEST_MIGU_SINGER_INDEX_LIMIT=50
CRAWLER_TEST_MYSQL_TIMEOUT_SECONDS=30

# 本地抓取测试如果证书链配置不完整，可临时关闭 TLS 校验
CRAWLER_OUTBOUND_VERIFY_TLS=true
# 下载音频、歌词等资源时允许较大的响应体；默认 10MB 只适合元数据接口
CRAWLER_OUTBOUND_MAX_RESPONSE_BYTES=209715200
# 资源下载批次内 worker 数；单次请求的并发上限仍由 /api/migu/settings 或 resources/process.options 控制
CRAWLER_RESOURCE_WORKER_THREADS=8

# 歌曲资源本地缓存根目录：生产建议使用本机高速盘，例如 D:/migu-resource-cache；最终会生成 migu/... 相对路径
CRAWLER_STORAGE_PATH=D:/migu-resource-cache

# 歌曲资源本地存储后端：默认 filesystem；rclone 是旧远端 copyurl 模式
CRAWLER_RESOURCE_STORAGE_BACKEND=filesystem

# 主采集流程当前不加载云端上传，完成 provider 获取 URL、解析、下载和 SQL 本地回写后，由人工上传和对账脚本回填 cloud_path
CRAWLER_RESOURCE_CLOUD_UPLOAD_ENABLED=false
CRAWLER_RESOURCE_CLOUD_UPLOAD_BACKEND=baidupcs
# 云端根目录保留给后续对账脚本和上传 adapter 使用；本地相对路径 migu/... 对应 /Media/migu/...
CRAWLER_RESOURCE_CLOUD_ROOT=/Media
CRAWLER_BAIDUPCS_GO_PATH=D:/AI/code/BaiduPCS-Go/BaiduPCS-Go.exe
CRAWLER_BAIDUPCS_UPLOAD_PARALLEL=8
CRAWLER_BAIDUPCS_UPLOAD_LOAD=8
CRAWLER_BAIDUPCS_UPLOAD_RETRIES=3
CRAWLER_BAIDUPCS_UPLOAD_POLICY=overwrite

# rclone RC 配置：真实用户名、密码和目标盘请写入本机 .env 或通过 CRAWLER_ENV_FILE 指向的私有 env 文件
CRAWLER_RCLONE_RC_URL=http://127.0.0.1:5572
CRAWLER_RCLONE_RC_USER=
CRAWLER_RCLONE_RC_PASSWORD=
# target fs 建议指向资源存储根目录，例如 gcloud:Media；实际对象路径由后端生成为 migu/songs/...
CRAWLER_RCLONE_TARGET_FS=gcloud:Media
CRAWLER_RCLONE_API_TIMEOUT_MS=10000
CRAWLER_RCLONE_JOB_TIMEOUT_MS=600000
CRAWLER_RCLONE_JOB_POLL_INTERVAL_MS=2000
CRAWLER_RCLONE_API_MAX_RESPONSE_BYTES=1048576

# 本地 MRC 下载完成后生成逐字 JSON 和增强 LRC；为空时禁用，不记录密钥。
# 密钥由运行环境提供，不提交真实值；远端 rclone 复制模式暂不执行本地歌词处理。
CRAWLER_MIGU_MRC_KEY=
