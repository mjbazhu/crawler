# Crawler MySQL 配置示例。复制为 .env 或 .env.test 后填写真实连接信息。
CRAWLER_PERSISTENCE_BACKEND=mysql
CRAWLER_MYSQL_HOST=127.0.0.1
CRAWLER_MYSQL_PORT=3306
CRAWLER_MYSQL_USER=root
CRAWLER_MYSQL_PASSWORD=
CRAWLER_MYSQL_DATABASE=crawler
# schema 默认启动初始化使用 migrations。
CRAWLER_MYSQL_MIGRATIONS_PATH=sql/mysql/migrations
CRAWLER_MYSQL_INIT_SCHEMA=true
CRAWLER_MYSQL_IO_THREADS=2
CRAWLER_MYSQL_MAX_POOL_SIZE=4
CRAWLER_MYSQL_CONNECT_TIMEOUT_SECONDS=5
CRAWLER_MYSQL_RETRY_INTERVAL_SECONDS=2
CRAWLER_MYSQL_PING_TIMEOUT_SECONDS=5
CRAWLER_MYSQL_STARTUP_TIMEOUT_MS=30000

# 运行日志配置。控制台始终输出文本；文本文件和 JSONL 文件可独立开启，也可同时保存。
CRAWLER_LOG_LEVEL=info
CRAWLER_LOG_CONSOLE=true
CRAWLER_LOG_TEXT_FILE_ENABLED=true
CRAWLER_LOG_TEXT_FILE=logs/crawler.log
CRAWLER_LOG_JSON_FILE_ENABLED=false
CRAWLER_LOG_JSON_FILE=logs/crawler.jsonl

# 集成测试参数。
CRAWLER_TEST_MIGU_SINGER_ID=112
CRAWLER_TEST_MIGU_LIMIT=20
CRAWLER_TEST_MIGU_ALBUM_LIMIT=20
CRAWLER_TEST_MIGU_SINGER_TAB=huayu-nan
CRAWLER_TEST_MIGU_SINGER_INDEX_LIMIT=50
CRAWLER_TEST_MYSQL_TIMEOUT_SECONDS=30

# 本地抓取测试如果证书链配置不完整，可临时关闭 TLS 校验。
CRAWLER_OUTBOUND_VERIFY_TLS=true
# 下载音频、歌词等资源时允许较大的响应体；默认 10MB 只适合元数据接口。
CRAWLER_OUTBOUND_MAX_RESPONSE_BYTES=209715200
# 资源下载批次内 worker 数；单次请求的并发上限仍由 /api/migu/settings 或 resources/process.options 控制。
CRAWLER_RESOURCE_WORKER_THREADS=8
